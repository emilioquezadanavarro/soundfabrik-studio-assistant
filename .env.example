OPENAI_API_KEY="your-api-key"
ANTHROPIC_API_KEY="your-api-key"

# Optional: point ingestion at the real (private) studio content instead of
# the tracked sample-docs/sample-assets. Not needed for `clone && run`.
# DOCS_DIR="studio-docs"
# ASSETS_DIR="studio-assets"

# Optional: Franz's persona uses these instead of the sample-docs default
# ("Klangraum Berlin"). Set them to match whatever DOCS_DIR you're using.
# STUDIO_NAME="Soundfabrik Berlin"
# STUDIO_ADDRESS="Salzufer 15-16, 10587 Berlin"

# Optional: LangSmith tracing. Get a key at smith.langchain.com. evals/run.py always overrides LANGSMITH_PROJECT to
# "studio-assistant-tracing-evals" regardless of what's set here. If your LangSmith
# workspace is EU-hosted, you also need LANGSMITH_ENDPOINT (check under
# Settings in the LangSmith UI, or the /sessions API returns 403 on the
# default US endpoint but 200 on the EU one if this is missing/wrong).
# LANGSMITH_TRACING="true"
# LANGSMITH_API_KEY="your-langsmith-key"
# LANGSMITH_PROJECT="studio-assistant-tracing-dev"
# LANGSMITH_ENDPOINT="https://eu.api.smith.langchain.com"